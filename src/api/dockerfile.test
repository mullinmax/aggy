FROM apache/airflow:slim-latest-python3.9 as aggy-api

# Set the Airflow DAGs folder
ENV AIRFLOW__CORE__DAGS_FOLDER=/src/api/dags
ENV AIRFLOW__WEBSERVER__WEB_SERVER_HOST=0.0.0.0

WORKDIR /src

ENV TZ=America/New_York

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . /src/api

ENV PYTHONPATH="/src/api:${PYTHONPATH}"

USER root

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER airflow

EXPOSE 8000
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh", "test"]
