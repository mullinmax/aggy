# Built from the repository root, matching dockerfile: src/extension is part
# of what the API serves, so it has to be in the build context.
FROM python:3.11-slim AS aggy-api
WORKDIR /src

ENV TZ=America/New_York

# Match the runtime image: keep BLAS single-threaded in the container.
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

# glibc base: numpy/scipy/scikit-learn and psycopg2-binary all ship manylinux
# wheels, so no build toolchain is required.
COPY src/api/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY src/api /src/api
# the download endpoint zips these, so the tests need them too
COPY src/extension /src/extension

EXPOSE 8000

CMD pytest -x /src/api/tests/
