{
  "manifest_version": 3,
  "name": "Aggy",
  "version": "0.1.0",
  "description": "Save a page to your aggy feeds, or turn the site you're on into a source.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Aggy"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page to your default aggy feed"
    },
    "save-page-upvote": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Save the current page with an upvote"
    }
  }
}
