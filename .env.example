# Copy to .env and fill in. docker-compose reads this file automatically.

# Secret used to sign auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Cloudflare Tunnel token. Create a tunnel in the Cloudflare Zero Trust
# dashboard and paste its connector token here. Route public hostnames to
# the internal services (e.g. aggy-api:8000) from the dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# Ollama model used to embed items for relevance ranking.
# nomic-embed-text handles up to 8192 tokens, enough for full articles.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Context window (and physical batch size) used when embedding items.
# Ollama defaults to 2048, which rejects longer items with a 500 error and
# leaves them without an embedding. Raise this if you embed longer documents
# (needs more RAM); it must not exceed the model's max context.
OLLAMA_EMBEDDING_NUM_CTX=8192

# Preview images are embedded by the bundled CLIP service (aggy-image-embed in
# docker-compose) so the recommender can score the picture itself, not just
# whether one exists. docker-compose points the API at the service; these only
# need changing if you run the service elsewhere or swap the CLIP model.
# IMAGE_EMBED_HOST=aggy-image-embed
# IMAGE_EMBED_PORT=8000
# CLIP model the service runs; must match the one baked into aggy-image-embed.
IMAGE_EMBED_MODEL=clip-ViT-B-32
# Seconds to wait when downloading a preview image / calling the embed service.
IMAGE_EMBED_TIMEOUT_SECONDS=30
# Articles scraped before the service existed are embedded by a background pass:
# every this-many minutes it takes a batch of the newest articles still missing
# a vector and works them this many at a time. Raise the batch and concurrency
# to chew through a large backlog faster, at the cost of more load on the image
# hosts and the CLIP service.
IMAGE_EMBED_BACKFILL_INTERVAL_MINUTES=15
IMAGE_EMBED_BACKFILL_BATCH_SIZE=500
IMAGE_EMBED_BACKFILL_CONCURRENCY=4
# Plenty of preview images are gone for good (expired reddit signatures, deleted
# uploads), so each failure is counted on the article and pushes its next try
# out exponentially -- IMAGE_EMBED_RETRY_MINUTES, doubling, capped at
# IMAGE_EMBED_MAX_RETRY_MINUTES -- until IMAGE_EMBED_MAX_ATTEMPTS gives up on it
# for good. Otherwise dead images fill every batch and the backlog never moves.
IMAGE_EMBED_MAX_ATTEMPTS=6
IMAGE_EMBED_RETRY_MINUTES=60
IMAGE_EMBED_MAX_RETRY_MINUTES=4320

# Ollama chat model used to suggest CSS selectors when adding a source from
# a bare website URL (the "From Website" tab). Any model that supports
# structured JSON output works; it is pulled automatically on first use.
OLLAMA_ANALYSIS_MODEL=qwen3:4b

# Set to false to disable new account creation
SIGNUP_ENABLED=true
